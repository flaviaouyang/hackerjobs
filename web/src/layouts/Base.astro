---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Analytics is on only for builds with a GoatCounter site code, e.g. the deployed site.
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply a saved light/dark choice before the page paints (see ThemeSwitch).
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {
      goatcounter && (
        <>
          <script is:inline>
            // Count the page without its query string, which holds filters and search text.
            window.goatcounter = { path: () => location.pathname };
          </script>
          <script
            is:inline
            async
            data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
            src="https://gc.zgo.at/count.js"
          />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to results</a>
    <slot />
    <footer class="site">
      <div class="wrap">
        <span>
          From the Hacker News “Who is hiring?” and “Who wants to be hired?” threads. Every entry links to its
          original post.
        </span>
        <span>Exchange rates: <a href="https://www.bankofcanada.ca/rates/exchange/">Bank of Canada</a>.</span>
        <span>
          Made by <a href="https://github.com/flaviaouyang">Flavia Ouyang</a>{' · '}<a
            href="https://github.com/flaviaouyang/hackerjobs">Source on GitHub</a
          >
        </span>
      </div>
    </footer>
  </body>
</html>
